# Copier ce fichier en terraform.tfvars puis remplacer les valeurs.
# terraform.tfvars n'est pas versionné.

# Votre IP publique suivie de /32 (obtenue via https://checkip.amazonaws.com)
ssh_allowed_cidr = "203.0.113.10/32"

# Clé publique SSH installée sur le serveur web (la même qu'en phase 1)
ssh_public_key_path = "~/.ssh/id_ed25519_phase1.pub"
