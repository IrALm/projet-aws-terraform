# Terraform : dossiers de travail et fichiers d'état (contiennent IDs, IP, parfois des secrets)
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
tfplan
crash.*.log

# Valeurs propres à chaque poste (le modèle terraform.tfvars.example reste versionné)
*.tfvars
!*.tfvars.example

# Exports de base de données (contiennent des données personnelles)
backup/

# Sorties brutes des tests de charge (résultats résumés dans les README)
loadtest-results/

# Clés et identifiants
*.pem
*.key
id_*
.aws/

# Dépendances Node.js installées localement
node_modules/
